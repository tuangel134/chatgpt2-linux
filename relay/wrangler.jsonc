{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt2-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "ForjaRelayRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ForjaRelayRoom"] }]
}
